# =============================================
#  Clash of Clans Bot – .gitignore
# =============================================

# --- YOUR PERSONAL COORDINATES (keep private) ---
All_Tags.json
Coordinates/
Coordinates.txt

# --- PyInstaller build output ---
build/
dist/
*.spec

# --- Backup folders ---
BAckups/
Backups/
backups/

# --- Zip/archive files ---
*.zip
*.rar
*.7z

# --- Python cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
Pointer/__pycache__/

# --- Virtual environments ---
venv/
.venv/
env/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
